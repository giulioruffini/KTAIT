import Mathlib
import KTAIT.ComputationCores

/-!
# Operational factors and behavioral quotients (WP0004)

The monoids consist of actual state transformations, not syntactic words.
Surjectivity of the state projection makes the induced transformation map
well defined and unique. All operation sequences are read chronologically.
-/

namespace KTAIT.OperationalAlgebra

open Function
open KTAIT.ComputationCores (run run_intertwines)

variable {X Q A V : Type*}

private theorem run_append (F : A → X → X) (x : X) (u v : List A) :
    run F x (u ++ v) = run F (run F x u) v := by
  simp [run, List.foldl_append]

/-- The transformation monoid generated by the admitted labeled operations. -/
def generated (F : A → X → X) : Submonoid (Function.End X) where
  carrier := {f | ∃ w : List A, f = fun x => run F x w}
  one_mem' := ⟨[], rfl⟩
  mul_mem' := by
    rintro f g ⟨u, rfl⟩ ⟨v, rfl⟩
    exact ⟨v ++ u, funext fun x => (run_append F x v u).symm⟩

private noncomputable def representingWord (F : A → X → X) (m : generated F) : List A :=
  m.property.choose

private theorem representingWord_spec (F : A → X → X) (m : generated F) :
    m.val = fun x => run F x (representingWord F m) := m.property.choose_spec

private noncomputable def descendedMap (F : A → X → X) (G : A → Q → Q)
    (m : generated F) : generated G :=
  ⟨fun q => run G q (representingWord F m), representingWord F m, rfl⟩

private theorem descendedMap_commutes (F : A → X → X) (G : A → Q → Q)
    (ρ : X → Q) (h : ∀ a x, ρ (F a x) = G a (ρ x)) (m : generated F) (x : X) :
    ρ (m.val x) = (descendedMap F G m).val (ρ x) := by
  rw [representingWord_spec F m]
  exact run_intertwines F G ρ h x (representingWord F m)

/-- Generator preservation induces a homomorphism of realized transformation monoids. -/
noncomputable def generatedFactor (F : A → X → X) (G : A → Q → Q)
    (ρ : X → Q) (hρ : Surjective ρ) (h : ∀ a x, ρ (F a x) = G a (ρ x)) :
    generated F →* generated G where
  toFun := descendedMap F G
  map_one' := by
    apply Subtype.ext
    funext q
    obtain ⟨x, rfl⟩ := hρ q
    exact (descendedMap_commutes F G ρ h 1 x).symm
  map_mul' := by
    intro m n
    apply Subtype.ext
    funext q
    obtain ⟨x, rfl⟩ := hρ q
    change (descendedMap F G (m * n)).val (ρ x) =
      (descendedMap F G m).val ((descendedMap F G n).val (ρ x))
    rw [← descendedMap_commutes F G ρ h n x,
      ← descendedMap_commutes F G ρ h m (n.val x)]
    exact (descendedMap_commutes F G ρ h (m * n) x).symm

/-- The induced monoid map intertwines each realized transformation. -/
theorem generated_factor_commutes (F : A → X → X) (G : A → Q → Q)
    (ρ : X → Q) (hρ : Surjective ρ) (h : ∀ a x, ρ (F a x) = G a (ρ x))
    (m : generated F) (x : X) :
    ρ (m.val x) = (generatedFactor F G ρ hρ h m).val (ρ x) :=
  descendedMap_commutes F G ρ h m x

/-- Every retained word transformation is the image of its source transformation. -/
theorem generated_factor_surjective (F : A → X → X) (G : A → Q → Q)
    (ρ : X → Q) (hρ : Surjective ρ) (h : ∀ a x, ρ (F a x) = G a (ρ x)) :
    Surjective (generatedFactor F G ρ hρ h) := by
  rintro ⟨g, w, rfl⟩
  refine ⟨⟨fun x => run F x w, w, rfl⟩, ?_⟩
  apply Subtype.ext
  funext q
  obtain ⟨x, rfl⟩ := hρ q
  rw [← generated_factor_commutes F G ρ hρ h]
  exact run_intertwines F G ρ h x w

/-- The commuting state-space diagram determines the monoid factor uniquely. -/
theorem generated_factor_unique (F : A → X → X) (G : A → Q → Q)
    (ρ : X → Q) (hρ : Surjective ρ) (h : ∀ a x, ρ (F a x) = G a (ρ x))
    (π : generated F →* generated G)
    (hπ : ∀ m x, ρ (m.val x) = (π m).val (ρ x)) :
    π = generatedFactor F G ρ hρ h := by
  apply MonoidHom.ext
  intro m
  apply Subtype.ext
  funext q
  obtain ⟨x, rfl⟩ := hρ q
  exact (hπ m x).symm.trans (generated_factor_commutes F G ρ hρ h m x)

/-- A common retained action with bijective projections gives a conjugacy. -/
theorem common_factor_conjugacy {Y : Type*} (F : A → X → X) (H : A → Y → Y)
    (G : A → Q → Q) (e : X ≃ Q) (f : Y ≃ Q)
    (he : ∀ a x, e (F a x) = G a (e x)) (hf : ∀ a y, f (H a y) = G a (f y)) :
    ∀ a x, (e.trans f.symm) (F a x) = H a ((e.trans f.symm) x) := by
  intro a x
  apply f.injective
  simpa using (he a x).trans (by simp [hf])

/-- Stability under each generator implies stability under every operation word. -/
theorem stable_under_words (F : A → X → X) (E : Setoid X)
    (stable : ∀ a x y, E x y → E (F a x) (F a y))
    (x y : X) (hxy : E x y) (w : List A) : E (run F x w) (run F y w) := by
  induction w generalizing x y with
  | nil => exact hxy
  | cons a w ih => exact ih (F a x) (F a y) (stable a x y hxy)

/-- Equality of every future descriptor, including the empty experiment. -/
def futureEquivalence (F : A → X → X) (c : X → V) : Setoid X where
  r x y := ∀ w : List A, c (run F x w) = c (run F y w)
  iseqv := ⟨fun _ _ => rfl, fun h w => (h w).symm, fun h k w => (h w).trans (k w)⟩

/-- Future equivalence preserves the present descriptor. -/
theorem future_equivalence_content (F : A → X → X) (c : X → V) :
    futureEquivalence F c ≤ Setoid.ker c := by
  intro x y h
  exact h []

/-- Future equivalence is stable under each admitted operation. -/
theorem future_equivalence_stable (F : A → X → X) (c : X → V)
    (a : A) (x y : X) (h : futureEquivalence F c x y) :
    futureEquivalence F c (F a x) (F a y) := by
  intro w
  exact h (a :: w)

/-- Every stable descriptor-preserving equivalence is contained in future equivalence. -/
theorem future_equivalence_greatest (F : A → X → X) (c : X → V) (E : Setoid X)
    (content : E ≤ Setoid.ker c)
    (stable : ∀ a x y, E x y → E (F a x) (F a y)) :
    E ≤ futureEquivalence F c := by
  intro x y h w
  exact content (stable_under_words F E stable x y h w)

/-- Retaining more observations can only refine behavioral equivalence. -/
theorem richer_descriptors_refine {W : Type*} (F : A → X → X)
    (c : X → V) (d : X → W) (J : W → V) (hc : c = J ∘ d) :
    futureEquivalence F d ≤ futureEquivalence F c := by
  intro x y h w
  simpa [hc, Function.comp_def] using congrArg J (h w)

/-- Adding admitted operations can only refine behavioral equivalence. -/
theorem more_operations_refine {B : Type*} (F : A → X → X) (G : B → X → X)
    (c : X → V) (ι : A → B) (h : ∀ a, G (ι a) = F a) :
    futureEquivalence G c ≤ futureEquivalence F c := by
  apply future_equivalence_greatest F c _ (future_equivalence_content G c)
  intro a x y hxy
  rw [← h a]
  exact future_equivalence_stable G c (ι a) x y hxy

/-- One simultaneous partition-refinement step. -/
def refine (F : A → X → X) (E : Setoid X) : Setoid X where
  r x y := E x y ∧ ∀ a, E (F a x) (F a y)
  iseqv := by
    refine ⟨fun x => ⟨E.refl x, fun a => E.refl _⟩, ?_, ?_⟩
    · intro x y h; exact ⟨E.symm h.1, fun a => E.symm (h.2 a)⟩
    · intro x y z h k; exact ⟨E.trans h.1 k.1, fun a => E.trans (h.2 a) (k.2 a)⟩

/-- Refinement only splits blocks. -/
theorem refine_le (F : A → X → X) (E : Setoid X) : refine F E ≤ E :=
  fun _ _ h => h.1

/-- A fixed partition is exactly one stable under the generators. -/
theorem refine_eq_iff_stable (F : A → X → X) (E : Setoid X) :
    refine F E = E ↔ ∀ a x y, E x y → E (F a x) (F a y) := by
  constructor
  · intro h a x y hxy
    exact ((show E ≤ refine F E by rw [h]) hxy).2 a
  · intro h
    apply le_antisymm (refine_le F E)
    exact fun x y hxy => ⟨hxy, fun a => h a x y hxy⟩

/-- Iteration starts from the descriptor kernel. -/
def refinement (F : A → X → X) (c : X → V) : ℕ → Setoid X
  | 0 => Setoid.ker c
  | n + 1 => refine F (refinement F c n)

/-- Every stage preserves the descriptor and contains future equivalence. -/
theorem refinement_bounds (F : A → X → X) (c : X → V) (n : ℕ) :
    futureEquivalence F c ≤ refinement F c n ∧ refinement F c n ≤ Setoid.ker c := by
  induction n with
  | zero => exact ⟨future_equivalence_content F c, le_rfl⟩
  | succ n ih =>
    constructor
    · intro x y h
      exact ⟨ih.1 h, fun a => ih.1 (future_equivalence_stable F c a x y h)⟩
    · exact (refine_le F _).trans ih.2

/-- Once refinement stops, it has computed the greatest operational quotient. -/
theorem stable_refinement_eq_future (F : A → X → X) (c : X → V) (n : ℕ)
    (h : refinement F c (n + 1) = refinement F c n) :
    refinement F c n = futureEquivalence F c := by
  apply le_antisymm
  · exact future_equivalence_greatest F c _ (refinement_bounds F c n).2
      ((refine_eq_iff_stable F _).mp h)
  · exact (refinement_bounds F c n).1

private theorem quotient_map_surjective {E D : Setoid X} (h : E ≤ D) :
    Surjective (Setoid.map_of_le h) := by
  intro q
  induction q using Quotient.inductionOn with
  | h x => exact ⟨Quotient.mk E x, rfl⟩

/-- A proper refinement of a finite partition strictly increases its block count. -/
theorem proper_refinement_increases_blocks [Finite X] (E D : Setoid X) (h : E < D) :
    Nat.card (Quotient D) < Nat.card (Quotient E) := by
  classical
  letI : Fintype (Quotient E) := Fintype.ofFinite _
  letI : Fintype (Quotient D) := Fintype.ofFinite _
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
  apply Fintype.card_lt_of_surjective_not_injective (Setoid.map_of_le h.le)
    (quotient_map_surjective h.le)
  intro hinj
  apply h.not_ge
  intro x y hxy
  apply Quotient.exact
  apply hinj (a₁ := Quotient.mk E x) (a₂ := Quotient.mk E y)
  exact Quotient.sound hxy

/-- For nonempty finite state spaces, refinement stabilizes before `card X` steps. -/
theorem refinement_stabilizes [Fintype X] [Nonempty X] (F : A → X → X) (c : X → V) :
    ∃ n < Fintype.card X, refinement F c (n + 1) = refinement F c n := by
  classical
  by_contra! h
  have lower : ∀ k, k ≤ Fintype.card X → k + 1 ≤ Nat.card (Quotient (refinement F c k)) := by
    intro k
    induction k with
    | zero =>
      intro _
      letI : Nonempty (Quotient (refinement F c 0)) :=
        ⟨Quotient.mk _ (Classical.arbitrary X)⟩
      exact Nat.card_pos (α := Quotient (refinement F c 0))
    | succ k ih =>
      intro hk
      have hstrict : refinement F c (k + 1) < refinement F c k :=
        lt_of_le_of_ne (refine_le F _) (h k (by omega))
      have hcard := proper_refinement_increases_blocks _ _ hstrict
      have hp := ih (by omega)
      omega
  have hlo := lower (Fintype.card X) le_rfl
  have hhi : Nat.card (Quotient (refinement F c (Fintype.card X))) ≤ Fintype.card X := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_le_of_surjective _ Quotient.mk_surjective
  omega

/-- Finite partition refinement computes the greatest stable descriptor quotient. -/
theorem finite_refinement_computes_future [Fintype X] [Nonempty X]
    (F : A → X → X) (c : X → V) :
    ∃ n < Fintype.card X, refinement F c n = futureEquivalence F c := by
  obtain ⟨n, hn, h⟩ := refinement_stabilizes F c
  exact ⟨n, hn, stable_refinement_eq_future F c n h⟩

/-- Refinement needs at most `n` evaluations of signatures of length `k+1`.
This counts signature entries; a hash-table runtime bound additionally needs its cost model. -/
theorem refinement_entry_budget [Fintype X] [Nonempty X] [Fintype A]
    (F : A → X → X) (c : X → V) :
    ∃ r < Fintype.card X,
      refinement F c (r + 1) = refinement F c r ∧
      (r + 1) * (Fintype.card X * (Fintype.card A + 1)) ≤
        (Fintype.card A + 1) * (Fintype.card X)^2 := by
  obtain ⟨r, hr, hs⟩ := refinement_stabilizes F c
  refine ⟨r, hr, hs, ?_⟩
  calc (r + 1) * (Fintype.card X * (Fintype.card A + 1)) ≤
      Fintype.card X * (Fintype.card X * (Fintype.card A + 1)) :=
        Nat.mul_le_mul_right _ (by omega)
       _ = _ := by ring

/-- An onto state factor of an onto update is onto. -/
theorem surjective_factor (F : X → X) (G : Q → Q) (ρ : X → Q)
    (hF : Surjective F) (hρ : Surjective ρ)
    (h : ∀ x, ρ (F x) = G (ρ x)) : Surjective G := by
  intro q
  obtain ⟨x, rfl⟩ := hρ q
  obtain ⟨y, rfl⟩ := hF x
  exact ⟨ρ y, (h y).symm⟩

/-- On a finite target the descended onto update is bijective. -/
theorem finite_surjective_factor_bijective [Finite Q]
    (F : X → X) (G : Q → Q) (ρ : X → Q) (hF : Surjective F) (hρ : Surjective ρ)
    (h : ∀ x, ρ (F x) = G (ρ x)) : Bijective G := by
  exact ⟨(Finite.injective_iff_surjective).mpr (surjective_factor F G ρ hF hρ h),
    surjective_factor F G ρ hF hρ h⟩

/-- Descending both inverse operations preserves their inverse equations. -/
theorem descended_inverse (e : X ≃ X) (G H : Q → Q) (ρ : X → Q)
    (hρ : Surjective ρ) (hG : ∀ x, ρ (e x) = G (ρ x))
    (hH : ∀ x, ρ (e.symm x) = H (ρ x)) : LeftInverse H G ∧ RightInverse H G := by
  constructor <;> intro q <;> obtain ⟨x, rfl⟩ := hρ q
  · rw [← hG, ← hH]; simp
  · rw [← hH, ← hG]; simp

/-- Reversible swapping realizes reset only with a prepared auxiliary bit. -/
theorem prepared_swap_reset :
    (∀ q : Bool, (Prod.swap (q, false)).1 = false) ∧
    (∀ p : Bool × Bool, Prod.swap (Prod.swap p) = p) ∧
    ¬ (∀ p : Bool × Bool, (Prod.swap p).1 = false) := by decide

/-- Reset is not the global onto factor of any surjective update. -/
theorem reset_not_global_factor (F : X → X) (ρ : X → Bool)
    (hF : Surjective F) (hρ : Surjective ρ) :
    ¬ (∀ x, ρ (F x) = false) := by
  intro h
  obtain ⟨q, hq⟩ := surjective_factor F (fun _ => false) ρ hF hρ h true
  cases hq

/-- A bijective two-sided shift. -/
def twoSidedShift : (ℤ → Bool) ≃ (ℤ → Bool) where
  toFun s n := s (n + 1)
  invFun s n := s (n - 1)
  left_inv s := by funext n; simp
  right_inv s := by funext n; simp

/-- Its forward factor forgets the initial entry of a one-sided sequence. -/
def oneSidedShift (s : ℕ → Bool) (n : ℕ) : Bool := s (n + 1)

/-- Restriction to nonnegative positions is onto and intertwines the two shifts. -/
theorem one_sided_shift_factor :
    Surjective (fun s : ℤ → Bool => fun n : ℕ => s n) ∧
    (∀ s : ℤ → Bool, (fun n : ℕ => twoSidedShift s n) =
      oneSidedShift (fun n : ℕ => s n)) ∧
    Surjective oneSidedShift ∧ ¬ Injective oneSidedShift := by
  constructor
  · intro s
    exact ⟨fun n => s n.toNat, by funext n; simp⟩
  constructor
  · intro s; funext n; simp [twoSidedShift, oneSidedShift]
  constructor
  · intro s
    refine ⟨fun n => if n = 0 then false else s (n - 1), ?_⟩
    funext n
    simp [oneSidedShift]
  · intro h
    have eq := h (a₁ := fun _ => false) (a₂ := fun n => n == 0) (by
      funext n; simp [oneSidedShift])
    have := congrFun eq 0
    simp at this

/-- Integer iteration of a bijection has the first-isomorphism-theorem quotient. -/
noncomputable def iterationQuotient (e : Equiv.Perm X) :
    (Multiplicative ℤ) ⧸ ((zpowersHom (Equiv.Perm X)) e).ker ≃*
      ((zpowersHom (Equiv.Perm X)) e).range :=
  QuotientGroup.quotientKerEquivRange _

/-- Integer powers are faithful exactly when the bijection has infinite order. -/
theorem faithful_integer_iteration (e : Equiv.Perm X) :
    Injective (fun n : ℤ => e ^ n) ↔ ¬ IsOfFinOrder e :=
  injective_zpow_iff_not_isOfFinOrder

/-- Operation-preserving surjections compose. -/
theorem composed_factors {R : Type*} (F : A → X → X) (G : A → Q → Q)
    (H : A → R → R) (ρ : X → Q) (σ : Q → R)
    (hρ : Surjective ρ) (hσ : Surjective σ)
    (hF : ∀ a x, ρ (F a x) = G a (ρ x))
    (hG : ∀ a q, σ (G a q) = H a (σ q)) :
    Surjective (σ ∘ ρ) ∧ ∀ a x, (σ ∘ ρ) (F a x) = H a ((σ ∘ ρ) x) := by
  exact ⟨hσ.comp hρ, fun a x => by simp only [Function.comp_apply, hF, hG]⟩

/-- A singleton factor can preserve only constant content. -/
theorem singleton_content_constant {V : Type*} (c : X → V) (d : Unit → V)
    (h : ∀ x, c x = d ()) : ∀ x y, c x = c y := by
  intro x y
  rw [h x, h y]

/-- A submonoid of a finite group contains the inverse of each of its elements. -/
theorem finite_submonoid_inverse {G : Type*} [Group G] [Finite G]
    (S : Submonoid G) (g : G) (hg : g ∈ S) : g⁻¹ ∈ S := by
  let f : S → S := fun x => ⟨g * x.val, S.mul_mem hg x.property⟩
  have hf : Injective f := by
    intro x y h
    apply Subtype.ext
    exact mul_left_cancel (congrArg Subtype.val h)
  obtain ⟨y, hy⟩ := Finite.surjective_of_injective hf 1
  have hgy : g * y.val = 1 := congrArg Subtype.val hy
  have heq : y.val = g⁻¹ := by
    calc y.val = g⁻¹ * (g * y.val) := by simp
         _ = g⁻¹ := by rw [hgy, mul_one]
  exact heq ▸ y.property

/-- An involution generates exactly its identity and itself. -/
theorem involution_generated_elements {M : Type*} [Monoid M] (g : M)
    (hg : g * g = 1) (m : M) :
    m ∈ Submonoid.closure ({g} : Set M) ↔ m = 1 ∨ m = g := by
  rw [Submonoid.mem_closure_singleton]
  constructor
  · rintro ⟨n, rfl⟩
    rcases Nat.even_or_odd' n with ⟨k, rfl | rfl⟩
    · left; rw [pow_mul, pow_two, hg, one_pow]
    · right; rw [pow_succ, pow_mul, pow_two, hg, one_pow, one_mul]
  · rintro (h | h)
    · rw [h]; exact ⟨0, pow_zero g⟩
    · rw [h]; exact ⟨1, pow_one g⟩

end KTAIT.OperationalAlgebra
